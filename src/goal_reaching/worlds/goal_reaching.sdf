<?xml version="1.0"?>
<!--
  World for the goal-reaching experiments: ground, light and the robot.

  The robot is included from its URDF instead of being spawned afterwards, so it
  belongs to the initial state and 'reset all' puts it back at the origin. A robot
  spawned with 'create' is removed by 'reset all'.

  model:// paths are resolved through GZ_SIM_RESOURCE_PATH, which must contain the
  share directory of the installed packages (install/goal_reaching/share).
-->
<sdf version="1.12">
  <world name="goal_reaching">

    <!-- 1 ms physics step: one agent step of 0.1 s = 100 physics iterations.
         The real-time factor only matters when the world runs freely. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Systems (plugins) loaded by the world. Without Physics nothing moves;
         UserCommands provides the create/remove/set_pose services;
         SceneBroadcaster sends the scene to the GUI. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- sdformat converts the URDF to SDF when the world is loaded. -->
    <include>
      <uri>model://goal_reaching/urdf/diff_drive_robot.urdf</uri>
      <name>diff_drive_robot</name>
    </include>

  </world>
</sdf>
