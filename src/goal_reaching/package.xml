<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>goal_reaching</name>
  <version>0.0.0</version>
  <description>Gymnasium environment for a diff-drive robot that reaches a goal in Gazebo.</description>
  <maintainer email="erikaymat@gmail.com">Erik Aymat Urteaga</maintainer>
  <license>Apache-2.0</license>

  <!-- Used by the environment (goal_reaching/ros_env.py). Gymnasium is not in
       rosdep: it comes from requirements.txt in the virtual environment. -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>

  <!-- Used by launch/sim.launch.py. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Style and docstrings are checked by ruff (see ruff.toml), not by ament linters. -->
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <!-- Adds share/.. to GZ_SIM_RESOURCE_PATH when Gazebo is started through
         ros_gz_sim, so the world can include model://goal_reaching/urdf/... -->
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
